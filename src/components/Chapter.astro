---
interface Props {
  id: string;
  no: string;
  label: string;
  title: string;
}

const { id, no, label, title } = Astro.props;
---

<section
  id={id}
  class="grid grid-cols-[150px_minmax(0,1fr)] gap-x-[clamp(1.5rem,4vw,3.5rem)] border-b border-rule py-[clamp(4.5rem,9vw,8rem)] max-[900px]:grid-cols-1 max-[900px]:gap-y-2"
>
  <div
    class="flex flex-col gap-0.5 pt-[0.55rem] font-mono text-[0.82rem] max-[900px]:flex-row max-[900px]:items-baseline max-[900px]:gap-2 max-[900px]:pt-0"
    data-reveal
  >
    <span class="font-medium text-accent">{no}</span>
    <span class="uppercase tracking-[0.06em] text-muted">{label}</span>
  </div>

  <div class="max-w-[78ch]">
    <h2
      class="mb-6 text-[clamp(2.5rem,5vw,3.6rem)] font-semibold leading-[1.05] tracking-[-0.025em]"
      data-reveal
    >
      {title}
    </h2>
    <slot />
  </div>
</section>
